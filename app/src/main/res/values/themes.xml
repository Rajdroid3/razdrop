<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.RazDrop" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/raz_primary</item>
        <item name="android:colorPrimaryDark">@color/raz_background</item>
        <item name="android:colorAccent">@color/raz_primary</item>
        <item name="android:windowBackground">@color/raz_background</item>
        <item name="android:textColorPrimary">@color/raz_text_primary</item>
        <item name="android:textColorSecondary">@color/raz_text_secondary</item>
        <item name="android:navigationBarColor">@color/raz_background</item>
        <item name="android:statusBarColor">@color/raz_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- TV Leanback Theme -->
    <style name="Theme.RazDrop.Tv" parent="Theme.RazDrop">
        <item name="android:windowOverscan">true</item>
    </style>

    <!-- Dialog Theme -->
    <style name="Theme.RazDrop.Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:textColorPrimary">@color/raz_text_primary</item>
    </style>
</resources>
