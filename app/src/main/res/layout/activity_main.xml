<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/raz_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_razdrop_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/raz_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Device • Scanning"
                android:textColor="@color/raz_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Header Action Buttons -->
        <ImageButton
            android:id="@+id/btn_history"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/action_history"
            android:focusable="true"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/action_settings"
            android:focusable="true"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Top Action Cards: Send & Receive -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Send Card -->
        <LinearLayout
            android:id="@+id/card_send"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_send"
                android:tint="#0A0F1D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_send"
                android:textColor="#0A0F1D"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Receive Card -->
        <LinearLayout
            android:id="@+id/card_receive"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_receive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_receive"
                android:textColor="@color/raz_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Pairing & Connection Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Scan TV QR Code Button -->
        <Button
            android:id="@+id/btn_scan_qr"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_qr"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Scan TV QR"
            android:textColor="#0A0F1D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Enter TV PIN Button -->
        <Button
            android:id="@+id/btn_pair_pin"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:text="@string/action_pair_pin"
            android:textColor="@color/raz_primary"
            android:textSize="13sp" />

        <!-- Hotspot Toggle Button -->
        <Button
            android:id="@+id/btn_toggle_hotspot"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.9"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:text="@string/mode_hotspot"
            android:textColor="@color/raz_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Discovered Devices Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nearby Devices"
            android:textColor="@color/raz_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_scanning"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/raz_primary" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_peers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.6"
            android:src="@drawable/ic_wifi_lan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/no_peers_found"
            android:textColor="@color/raz_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Peer Devices List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_peers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
