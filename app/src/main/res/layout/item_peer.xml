<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Device Icon Container -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#1E2A47">

        <ImageView
            android:id="@+id/iv_device_type"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_phone" />
    </FrameLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_peer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Living Room TV"
            android:textColor="@color/raz_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_peer_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="192.168.1.45 • Wi-Fi"
            android:textColor="@color/raz_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Connection Mode Badge -->
    <TextView
        android:id="@+id/tv_badge_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#1500F2FE"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="LAN"
        android:textColor="@color/raz_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Action Arrow -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_send" />
</LinearLayout>
