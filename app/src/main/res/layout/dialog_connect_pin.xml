<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect to TV"
        android:textColor="@color/raz_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter the IP address and PIN shown on your TV screen."
        android:textColor="@color/raz_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TV IP Address"
        android:textColor="@color/raz_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_target_ip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#152138"
        android:hint="e.g. 192.168.1.100"
        android:inputType="textUri"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/raz_text_primary"
        android:textColorHint="@color/raz_text_tertiary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="TV 4-Digit PIN (Optional)"
        android:textColor="@color/raz_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_target_pin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#152138"
        android:hint="e.g. 4821"
        android:inputType="number"
        android:maxLength="4"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/raz_text_primary"
        android:textColorHint="@color/raz_text_tertiary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/action_cancel"
            android:textColor="@color/raz_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_dialog_connect"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="@string/action_connect"
            android:textColor="#0A0F1D"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
