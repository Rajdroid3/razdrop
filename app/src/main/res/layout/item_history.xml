<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_history_direction"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="#1A00F2FE"
        android:padding="8dp"
        android:src="@drawable/ic_receive" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_history_peer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Received from Galaxy S24"
            android:textColor="@color/raz_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_history_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="4 files • 128 MB • Completed"
            android:textColor="@color/raz_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_open_history"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_button_secondary"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/action_open_folder"
        android:textColor="@color/raz_primary"
        android:textSize="12sp" />
</LinearLayout>
