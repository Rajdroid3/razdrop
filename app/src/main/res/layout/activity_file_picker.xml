<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/raz_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_picker_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Select Files"
            android:textColor="@color/raz_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_browse_saf"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Browse System..."
            android:textColor="@color/raz_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Category Chips / Quick Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_media"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_secondary"
                android:focusable="true"
                android:text="Media (Photos/Videos)"
                android:textColor="@color/raz_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_docs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_secondary"
                android:focusable="true"
                android:text="Documents &amp; PDFs"
                android:textColor="@color/raz_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_apks"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_secondary"
                android:focusable="true"
                android:text="APKs / Apps"
                android:textColor="@color/raz_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_downloads"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary"
                android:focusable="true"
                android:text="Downloads"
                android:textColor="@color/raz_text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Selected Files List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_picker_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />

    <!-- Selection Summary Bar & Action -->
    <LinearLayout
        android:id="@+id/layout_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_selected_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No files selected"
            android:textColor="@color/raz_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_confirm_send"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_primary"
            android:enabled="false"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/action_send"
            android:textColor="#0A0F1D"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
