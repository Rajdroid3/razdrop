<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/raz_surface_elevated" />
            <corners android:radius="12dp" />
            <stroke android:width="2.5dp" android:color="@color/raz_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/raz_surface_elevated" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/raz_secondary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/raz_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/raz_stroke" />
        </shape>
    </item>
</selector>
