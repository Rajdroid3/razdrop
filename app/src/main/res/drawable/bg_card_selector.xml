<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused (TV D-pad or Keyboard) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/raz_surface_elevated" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/raz_primary" />
        </shape>
    </item>
    <!-- Pressed (Touch or TV Select) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/raz_surface_elevated" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/raz_secondary" />
        </shape>
    </item>
    <!-- Default Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/raz_surface_card" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="@color/raz_stroke" />
        </shape>
    </item>
</selector>
